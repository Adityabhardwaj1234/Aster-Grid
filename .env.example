# ASTERGRID server configuration.
# Copy to .env only if you want to override defaults. Never commit .env.

ASTERGRID_HOST=127.0.0.1
ASTERGRID_PORT=8000
ASTERGRID_DATA_DIR=
ASTERGRID_EXECUTION_MODE=deterministic
ASTERGRID_MAX_REVISIONS=2
ASTERGRID_RUN_TIMEOUT_SECONDS=120
ASTERGRID_RUNS_RETENTION=20
ASTERGRID_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional live-model mode. Leave empty to use deterministic policy agents.
GEMINI_API_KEY=
ASTERGRID_GEMINI_MODEL=gemini-2.5-flash
